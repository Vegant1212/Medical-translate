# Copia este archivo como .env.local y sustituye el valor por tu clave.
# .env.local está excluido de Git y no debe compartirse.
OPENAI_API_KEY=sk-tu-clave-aqui

# Opcional: equilibrio recomendado entre calidad y costo.
OPENAI_MODEL=gpt-5.6-terra

# Configuración pública de Supabase (Dashboard > Connect).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Las mismas variables para la función privada de Vercel.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret used by /api/chat. Never prefix this variable with VITE_ or EXPO_PUBLIC_.
AI_GATEWAY_API_KEY=

# Public Supabase configuration used only for user authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional when the frontend and API are served from different origins.
# VITE_API_BASE_URL=http://localhost:3000
